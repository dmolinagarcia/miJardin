# Configuración del despliegue en la devbox. Copia como .env (no va a git) y ajusta.

# ---------- Despliegue ----------

# Red Docker de devenv-caddy:  docker inspect devenv-caddy -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
CADDY_NETWORK=
# Rama de GitHub que se publica
JARDIN_RAMA=main

# ---------- Aplicación ----------

URL_PUBLICA=https://mijardin.devbox.org.es
COOKIE_SEGURA=si

# Primer administrador: solo se usa si todavía no hay usuarios. Bórralo tras la primera entrada.
ADMIN_USUARIO=
ADMIN_CLAVE=

REGISTRO_ABIERTO=si
LIMITE_PLANTAS_GRATIS=10

# ---------- Stripe (vacío = pagos desactivados) ----------

STRIPE_CLAVE_SECRETA=
STRIPE_PRECIO=
STRIPE_SECRETO_AVISOS=
# STRIPE_IMPUESTOS=si
# PRECIO_TEXTO=2 € al mes
