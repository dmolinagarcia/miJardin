# Copia este archivo como .env y ajústalo.

# Puerto en el que escucha el servidor
PUERTO=8080

# Carpeta de la base de datos (jardin.db). En Docker es /datos.
# DATOS=./datos

# Primer administrador: solo se usa si todavía no hay ningún usuario.
# Después puedes borrar estas dos líneas.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# Permitir que cualquiera se cree una cuenta desde la pantalla de entrada (si/no).
REGISTRO_ABIERTO=no

# Pon "si" cuando la web esté detrás de un proxy (Caddy, nginx, Traefik, Tailscale serve…)
# para leer la IP real y saber si la conexión es https.
CONFIAR_PROXY=no

# Cookie solo por https: auto (según la conexión), si o no.
COOKIE_SEGURA=auto
