# Copia este archivo como .env y ajústalo.

# Puerto en el que escucha el servidor
PUERTO=8080

# Carpeta de la base de datos (jardin.db). En Docker es /datos.
# DATOS=./datos

# Primer administrador: solo se usa si todavía no hay ningún usuario.
# Después puedes borrar estas dos líneas.
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambia-esta-clave

# Cualquiera puede crearse una cuenta desde la pantalla de entrada. Pon "no" para cerrarlo.
REGISTRO_ABIERTO=si

# ---------- Plan gratuito y suscripción ----------

# Plantas que se pueden tener en el plano sin pagar.
LIMITE_PLANTAS_GRATIS=10

# Dirección pública de la web (para volver desde la página de pago de Stripe).
# Si no se pone, se deduce de cada petición.
# URL_PUBLICA=https://jardin.tudominio.es

# Stripe (https://dashboard.stripe.com/apikeys). Sin estas dos, los pagos quedan desactivados
# y el límite sigue funcionando: solo la administración puede dar plantas sin límite.
# STRIPE_CLAVE_SECRETA=sk_live_...
# STRIPE_PRECIO=price_...

# Secreto del webhook de Stripe (opcional pero recomendado), para el aviso en /api/stripe/aviso.
# STRIPE_SECRETO_AVISOS=whsec_...

# Calcular el IVA con Stripe Tax (tiene que estar activado en tu cuenta de Stripe).
# STRIPE_IMPUESTOS=si

# Texto del precio que se enseña. Si no se pone, se pregunta a Stripe.
# PRECIO_TEXTO=2 € al mes

# Pon "si" cuando la web esté detrás de un proxy (Caddy, nginx, Traefik, Tailscale serve…)
# para leer la IP real y saber si la conexión es https.
CONFIAR_PROXY=no

# Cookie solo por https: auto (según la conexión), si o no.
COOKIE_SEGURA=auto
